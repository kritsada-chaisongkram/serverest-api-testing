        {
          "name": "User Management",
          "item": [
            {
              "name": "TC-USER-001 - Create Valid User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const jsonData = pm.response.json();\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response message should be Cadastro realizado com sucesso\", function () {\r\n    pm.expect(jsonData.message).to.eql(\"Cadastro realizado com sucesso\");\r\n});\r\n\r\npm.test(\"Response should have _id\", function(){\r\n    pm.expect(jsonData).to.have.property(\"_id\");\r\n});\r\n\r\npm.test(\"Response _id should be a non-empty string\", function () {\r\n    pm.expect(jsonData._id).to.be.a(\"string\");\r\n    pm.expect(jsonData._id).to.not.be.empty;\r\n});\r\n\r\n\r\n"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"nome\": \"QA Automation User\",\r\n  \"email\": \"{{$randomEmail}}\",\r\n  \"password\": \"test123456\",\r\n  \"administrador\": \"true\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/usuarios",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "usuarios"
                  ]
                }
              },
              "response": []
            },
